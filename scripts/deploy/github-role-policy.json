{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RedeployOnlyRoza",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:YOUR_REGION:YOUR_ACCOUNT_ID:document/Roza-Redeploy",
        "arn:aws:ec2:YOUR_REGION:YOUR_ACCOUNT_ID:instance/YOUR_INSTANCE_ID"
      ]
    },
    {
      "Sid": "ReadDeploymentResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
