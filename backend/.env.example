# Roza environment template - DEMO VALUES ONLY; no real credentials.
# Local development: copy this file to backend/.env (npm run dev reads that file).
# Launching the backend from the repository root: use root .env instead.
# dotenv loads only the working directory's .env; the two files are not merged.
# Existing process/container environment variables take precedence.
# Never overwrite an existing .env without preserving its real settings.
# No frontend .env is required. Keep all API keys on the backend.

# Runtime: npm scripts set NODE_ENV automatically. Use production in containers.
NODE_ENV=development

# MongoDB: local demo instance; replace DB_URL for a hosted/authenticated database.
DB_URL=mongodb://127.0.0.1:27017
DEV_DB_NAME=roza_dev
PROD_DB_NAME=roza_prod
# Tests can delete data. These must be dedicated test databases.
TEST_DB_NAME=roza_test
LOCAL_DB_URL=mongodb://127.0.0.1:27017/roza_test

# Login: replace this public demo secret with a long random private value.
JWT_SECRET_CODE=demo-only-replace-with-a-long-random-private-secret
JWT_EXPIRATION_TIME=7d

# EPUB Reader: both the flag and a matching logged-in user ID are required.
READER_ENABLED=true
# Demo MongoDB user ObjectId; replace with your actual user ID. Comma-separated.
READER_ALLOWED_USER_IDS=507f1f77bcf86cd799439011

# Reader AI chat: optional. Leave empty to keep AI chat unconfigured.
# Paste a real OpenAI API-project key here; ChatGPT subscriptions do not supply one.
# Example format only (not usable): sk-demo-not-a-real-api-key
OPENAI_API_KEY=
# Default used for legacy chat settings; per-user AI settings may override it.
READER_AI_MODEL=gpt-4.1-mini

# Audiobook OpenAI voices: optional; System voices work without these or a key.
# After setting a real key, change false to true and restart the local backend.
# OpenAI narration uses paid API calls; selecting a voice alone does not generate.
READER_AUDIOBOOK_ENABLED=false
# Supported models: gpt-realtime-2.1-mini or gpt-realtime-2.1.
READER_AUDIOBOOK_MODEL=gpt-realtime-2.1-mini
# Optional dedicated narration key; empty means reuse OPENAI_API_KEY above.
READER_AUDIOBOOK_OPENAI_API_KEY=

# Dictionary fallback: optional Google Cloud Translation Basic v2 API key.
# Leave empty to use local dictionary results without Google translation fallback.
GOOGLE_TRANSLATE_API_KEY=

# No PORT variable: the backend currently listens on 3030.
# Cloudinary cloud name/upload preset are currently configured in frontend source,
# not environment variables. Never place a Cloudinary API secret in the frontend.
# AWS deployment settings belong to GitHub repository variables and the server's
# /etc/roza-deploy.conf; copying this template does not deploy or enable production.
