# Backend only; opt in when ready to test. Do not put secrets in frontend environment files.
READER_AUDIOBOOK_ENABLED=false
READER_AUDIOBOOK_MODEL=gpt-realtime-2.1-mini
# Extra transcription for word highlighting; false keeps passage highlighting.
# whisper-1 timestamp support is scheduled to retire 2027-02-26.
READER_AUDIOBOOK_WORD_TIMINGS=true
# Optional dedicated speech key; otherwise OPENAI_API_KEY is reused.
READER_AUDIOBOOK_OPENAI_API_KEY=
